# Espressif's esp_lvgl_adapter PPA freeze workaround (DIG-734):
# https://components.espressif.com/components/espressif/esp_lvgl_adapter/versions/0.6.4/readme
# Compile a patched copy for ESP-IDF 6.0.x without modifying the shared SDK.
if(NOT CONFIG_IDF_TARGET_ESP32P4 OR NOT IDF_VERSION_MAJOR EQUAL 6 OR NOT IDF_VERSION_MINOR EQUAL 0)
    return()
endif()

idf_component_get_property(ppa_lib esp_driver_ppa COMPONENT_LIB)
idf_component_get_property(ppa_dir esp_driver_ppa COMPONENT_DIR)
set(srm_source "${ppa_dir}/src/ppa_srm.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${srm_source}")
file(READ "${srm_source}" srm_code)
set(old_call "ppa_ll_srm_bypass_mb_order(platform->hal.dev, bypass_mb_order);")
string(FIND "${srm_code}" "${old_call}" old_call_pos)
if(old_call_pos EQUAL -1)
    string(FIND "${srm_code}" "ppa_ll_srm_bypass_mb_order(platform->hal.dev, true);" patched)
    if(patched EQUAL -1)
        message(FATAL_ERROR "Unrecognized ESP-IDF 6.0 PPA SRM driver; review the DIG-734 workaround")
    endif()
    return()
endif()
string(REPLACE "${old_call}" "bypass_mb_order = true;\n    ${old_call}" srm_code "${srm_code}")

get_target_property(ppa_sources ${ppa_lib} SOURCES)
if(NOT srm_source IN_LIST ppa_sources)
    message(FATAL_ERROR "Cannot replace ${srm_source} in ${ppa_lib}")
endif()
list(REMOVE_ITEM ppa_sources "${srm_source}")
set(patched_source "${CMAKE_CURRENT_BINARY_DIR}/ppa_srm_workaround/ppa_srm.c")
file(CONFIGURE OUTPUT "${patched_source}" CONTENT "${srm_code}" @ONLY)
set_property(TARGET ${ppa_lib} PROPERTY SOURCES "${ppa_sources}")
target_sources(${ppa_lib} PRIVATE "${patched_source}")
target_include_directories(${ppa_lib} PRIVATE "${ppa_dir}/src")
message(STATUS "Applying ESP32-P4 PPA SRM freeze workaround (DIG-734)")
